# Server
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Exact browser origins, comma separated. Required in production; no paths or '*'.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Per-process failed-login budget per socket IP (X-Forwarded-For is not trusted).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Database (relative to packages/backend or absolute path)
DB_PATH=./src/data/database.sqlite
# Production requires a Neon PostgreSQL connection URL supplied through Render Environment.
# The local SQLite path applies only when DATABASE_URL is empty.
DATABASE_URL=

# JWT Secret (generate a private random string; production requires at least 32 chars)
JWT_SECRET=your_secret_key_here
# Positive integer seconds or integer s/m/h/d; default 1h.
JWT_EXPIRES_IN=2h
